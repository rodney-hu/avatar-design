{
  "name": "elemental-design",
  "version": "1.0.0",
  "description": "Elemental Design: a dark-first elemental design system for Tailwind CSS v4",
  "main": "src/index.css",
  "style": "src/index.css",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-tokens.mjs && node scripts/check-docs.mjs && vite build",
    "preview": "vite preview",
    "build:ds": "node scripts/build-ds-bundle.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "sync:brand": "node scripts/sync-brand.mjs"
  },
  "keywords": [
    "design-system",
    "tailwindcss",
    "tailwind-v4",
    "elemental-design",
    "elemental-theme",
    "dark-mode"
  ],
  "author": "Rodney Hu",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.10.2",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  }
}
