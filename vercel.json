{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/classic",
      "destination": "/classic/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!classic/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
